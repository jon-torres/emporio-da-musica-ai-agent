# LLM Provider Configuration
# Choose between: "gemini" (recommended free tier), "groq", "ollama", or "mock" (offline test mode)
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier via https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API Key (Free tier via https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Local free inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Application Settings
DATA_DIR=data
DATABASE_PATH=emporio.db
LOG_LEVEL=INFO
